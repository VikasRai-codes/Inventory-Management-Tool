<body>
    <main class="dashboard">
            <div class="sale-container">

        <div class="sale-header">
            <h1>Sell Product</h1>
            <p>Enter product details to process a sale</p>
        </div>

        <!-- Sale Form -->
        <form action="/api/sales" method="POST">

            <!-- Product ID -->
            <div class="form-group">

                <label for="productId">
                    Product ID
                </label>

                <input
                    type="text"
                    id="productId"
                    name="productId"
                    placeholder="Enter Product ID (e.g. 1001)"
                    required
                >

            </div>


            <!-- Quantity -->
            <div class="form-group">

                <label for="quantity">
                    Quantity
                </label>

                <input
                    type="number"
                    id="quantity"
                    name="quantity"
                    placeholder="Enter quantity"
                    min="1"
                    required
                >

            </div>


            <!-- Submit Button -->
            <button type="submit" class="sale-btn">
                Process Sale
            </button>

        </form>


         <% if (success) { %>
            <div class="message success-message">
                <span>✓</span>
                <p>
                    <%= success %>
                </p>
            </div><% } %>

        <% if (error) { %>
            <div class="message error-message"> <span>✕</span>
                <p><%= error %></p>
             </div><% } %>

    </div>
    </main>
    

</body>

</html>

